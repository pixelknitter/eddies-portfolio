#!/usr/bin/env bash
# Refuse to commit the plaintext of sealed content.
#
# CI runs `check` too, but CI runs *after* the commit exists and git history
# is append-only — a plaintext post that reaches a commit is public even if the
# next commit removes it. This hook runs while the mistake is still undoable,
# which makes it the guard that actually matters.
#
# Blob names are HMACs of the content path, so answering "is this sealed?"
# needs the key. One scrypt derivation (~85ms) covers the whole commit.
# Without the key we warn rather than block: a contributor who cannot decrypt
# anything also cannot meaningfully be checked, and blocking them helps nobody.
#
# Installed via core.hooksPath by `yarn hooks:install` (and postinstall).
set -euo pipefail

CONTENT_ROOT="packages/web-astro/src/content"

staged=$(git diff --cached --name-only --diff-filter=ACM -- "$CONTENT_ROOT" | grep '\.md$' || true)
[ -n "$staged" ] || exit 0

if [ -z "${CONTENT_SEAL_KEY:-}" ]; then
  echo "⚠ CONTENT_SEAL_KEY not set — cannot check staged content against the vault." >&2
  echo "  If you are committing a sealed story's plaintext, this will not catch it." >&2
  exit 0
fi

violations=""
while IFS= read -r path; do
  [ -n "$path" ] || continue
  if node scripts/seal-content.mjs is-sealed "$path" 2>/dev/null; then
    violations="${violations}  ${path}"$'\n'
  fi
done <<< "$staged"

# Keep the vault in step with edits made after an unseal. Only files whose
# content actually differs are re-encrypted, and the refreshed blob joins this
# commit so the vault can never drift behind the working copy.
if [ -z "$violations" ] && [ -n "${CONTENT_SEAL_KEY:-}" ]; then
  # `seal` with no path covers both cases: a new working copy with no blob,
  # and one that has drifted from its blob. `reseal-if-changed` only saw the
  # second, so a brand-new draft committed silently unsealed.
  if node scripts/seal-content.mjs seal 2>/dev/null | grep -qE 'sealed|resealed'; then
    git add packages/web-astro/content-vault
    echo "→ vault resealed and added to this commit"
  fi
fi

if [ -n "$violations" ]; then
  cat >&2 <<MSG

✖ Refusing to commit the plaintext of sealed content:

${violations}
  A sealed blob already exists for these, so committing the plaintext would put
  in history exactly what sealing was meant to keep out — and history cannot be
  un-published.

    git restore --staged <path>

  If something should no longer be sealed, remove its blob deliberately:
    node scripts/seal-content.mjs status     # see what is sealed

MSG
  exit 1
fi
