---
<div class="animate-on-scroll">
  <slot />
</div>

<script is:inline>
  function setupAnimations() {
    const animatedElements = document.querySelectorAll('.animate-on-scroll');

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in-view');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    animatedElements.forEach(el => observer.observe(el));
  }

  // Run on initial load
  setupAnimations();

  // Re-run on Astro page changes
  document.addEventListener('astro:page-load', setupAnimations);
</script>

<style>
  .animate-on-scroll {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.5s, transform 0.5s;
  }
  .animate-on-scroll.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  /* Honour the user's motion preference, which this component previously
     ignored — it hardcoded its own opacity and transition rather than reading
     the --animate-* variables motion.css defines for exactly this.
     Two consequences, both real. A visitor asking for reduced motion still got
     a half-second fade on every section. And because the element starts at
     opacity 0 and is revealed only by an IntersectionObserver, anything that
     stops that script leaves the content permanently invisible.
     It also made the site unmeasurable: mid-fade the element is partly
     transparent, so the accessibility audit resolved blended backgrounds like
     #534f5d — a colour in no palette — and reported contrast failures against
     them on links that are 8.81:1 against the real background. */
  @media (prefers-reduced-motion: reduce) {
    .animate-on-scroll {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>