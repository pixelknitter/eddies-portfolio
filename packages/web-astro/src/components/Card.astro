---
import { Image } from "astro:assets";

interface Props {
    url: string;
    /** Optional: an entry that has no artwork yet renders as a text card. */
    image?: string;
    title: string;
    body: string;
    alt?: string;
    /**
     * Small identifying line above the title — the entry's domain. Titles
     * and hooks are written to be evocative, which reads as misleading on a
     * card grid with nothing nominative to ground it. This is the ground.
     */
    kicker?: string;
}

const { url, image, title, body, alt = "", kicker } = Astro.props;
import GlowBorder from '@components/GlowBorder.astro';
---
{/*
  Rendered per card, emitted once: Astro bundles a component's `<script>` into
  one page asset regardless of how many instances render it. So every page that
  uses a Card gets the pointer-tracked ring with no wiring of its own.
*/}
<GlowBorder />
<li class="list-none">
  <a
    class="card-link surface group flex h-full flex-col overflow-hidden no-underline text-dark dark:text-light"
    href={url}
    data-glow
  >
    {image && (
      <div class="overflow-hidden">
        <Image class="w-full h-auto object-cover" width="452" height="254" src={image} alt={alt} />
      </div>
    )}
    <div class="flex flex-1 flex-col p-4">
      {kicker && (
        <p class="font-body text-xs uppercase tracking-wide opacity-70 m-0 mb-1">{kicker}</p>
      )}
      <!-- Section headings own the underline motif; on a card it becomes a
           hover state instead, so a grid of cards stays scannable. -->
      <!-- h2, not h3: Card is used only by the blog and works indexes, whose
           page title is the h1. At h3 the outline skipped a level. -->
      <h2 class="card-title font-body text-xl font-semibold leading-snug no-underline decoration-0 m-0">
        {title}
      </h2>
      <p class="mt-2 text-base leading-relaxed text-left">
        {body}
      </p>
    </div>
  </a>
</li>

<style>
  @reference "../styles/global.css";

  .card-link {
    /*
     * Border colour carries the *keyboard* state. A shadow-only affordance is
     * invisible when the card and the page share a background.
     */
    /*
     * `--glow-size` is listed here as well as on `.glow-card`, because
     * `transition` is a shorthand: this declaration *replaces* that one rather
     * than adding to it, and the glow's expansion silently stopped animating on
     * every card that used this component while it still worked on the chooser.
     */
    transition:
      border-color var(--animate-duration, 250ms) ease,
      transform var(--animate-duration, 250ms) ease,
      --glow-size 420ms cubic-bezier(0.34, 1.3, 0.64, 1);
  }

  /*
   * Hover is the pointer-tracked ring, not a border colour.
   *
   * A hover switch fires the instant the cursor crosses the edge, so the border
   * snapped to full strength while the ring was still fading up behind it — two
   * answers to the same question, arriving at different speeds. Focus keeps the
   * colour: a keyboard has no proximity to track, so it needs the binary state.
   */
  .card-link:focus-visible {
    @apply border-underline dark:border-link;
  }

  .card-link:focus-visible {
    @apply outline-2 outline-offset-2 outline-underline dark:outline-link;
  }

  .card-link:hover .card-title,
  .card-link:focus-visible .card-title {
    @apply underline decoration-underline dark:decoration-link decoration-2 underline-offset-[6px];
  }

  @media (prefers-reduced-motion: no-preference) {
    .card-link:hover,
    .card-link:focus-visible {
      transform: translateY(-2px);
    }
  }
</style>
