---
import { isResumeRoute, REQUEST_PATH } from '@util/resume/resume.data';
import { resolveSections } from '@util/flags/sections.mjs';

const year = new Date().getFullYear();

/**
 * The privacy link tracks the same `collectsData` gate as `/privacy` itself, so
 * the footer can never advertise a route that 404s. Read here rather than passed
 * in, because the footer renders on every page and no caller should have to
 * remember to supply it.
 */
const { collectsData } = await resolveSections(import.meta.env);

/**
 * On resume routes the mail icon becomes a link to the request form.
 *
 * The resume deliberately publishes no address — visitors are routed through the
 * request flow, which is what captures the lead and what gates the PDFs. A
 * `mailto:` in the footer of that same page walks straight around all of it, so
 * the icon changes target there and nowhere else.
 *
 * Decided from the pathname rather than a prop so a future resume route inherits
 * the behaviour instead of having to remember to ask for it.
 */
const gateContact = isResumeRoute(Astro.url.pathname);
---
<footer class="my-16 cursor-default p-0 list-none">
    <div class="text-center">
      <small class="block">Connect with a 👋</small>
        <ul class="flex cursor-default list-none p-0 gap-2 align-middle justify-center">
          <li class="inline-block">
            <a class="icon-btn" href="https://github.com/pixelknitter" target="_blank" rel="noopener noreferrer">
              <span class="git-icon block">GitHub</span>
            </a>
          </li>
          <li class="inline-block">
            <a
              class="icon-btn"
              href={gateContact ? REQUEST_PATH : 'mailto:connect@eddie.engineering'}
            >
              <span class="mail-icon block">{gateContact ? 'Request a copy' : 'Email'}</span>
            </a>
          </li>
          <li class="inline-block">
            <a class="icon-btn" href="https://linkedin.com/in/eddiefreeman" target="_blank" rel="noopener noreferrer">
              <span class="linked-in block">LinkedIn</span>
            </a>
          </li>
        </ul>
        {/*
          The paired link accent, not the bare one. Mint on the page ground
          measures 1.74:1 — a clear AA failure, and on every page, since this
          footer is in the base layout.
          `--color-link-on-light` was added for exactly this; its own comment in
          global.css names Footer.astro as the case that motivated it. The token
          then landed in LatestWork, 404 and Prose and never came back here, so
          the one file the fix was named after kept the failing colour.
        */}
        <small class="block mt-6">&copy; {year} Eddie Engineering by <a class="text-link-on-light dark:text-link no-underline" href="https://github.com/pixelknitter">pixelknitter</a>. All Rights Reserved.</small>
        {collectsData && <small class="block mt-2"><a class="text-link-on-light dark:text-link no-underline" href="/privacy">Privacy</a></small>}
      </div>
</footer>

