---
import { getCollection } from 'astro:content';
import { resolveSections } from '@util/flags/sections.mjs';

const sections = await resolveSections(import.meta.env);

// Drafts are hidden in production, matching the blog's behaviour.
const entries = sections.highlights
  ? await getCollection(
      'star',
      ({ data }) => sections.unpublished || data.draft !== true,
    )
  : [];

// One story per *day*, not per request. The random pick this replaced let
// anyone enumerate the whole STAR corpus by refreshing — and the spotlight
// is the only public surface for these stories outside A.I.R., which is
// where the full set is meant to be reached. A date-seeded pick keeps the
// rotation (the site renders per request, so it turns without a rebuild)
// while holding the exposure to one story a day. Sorted first: collection
// order is not guaranteed, and determinism is the point.
const daySeed = Math.floor(Date.now() / 86_400_000);
const ordered = [...entries].sort((a, b) => a.id.localeCompare(b.id));
const entry =
  ordered.length > 0 ? ordered[daySeed % ordered.length] : undefined;
---

{entry && (
  <section>
    <h2 class="mt-6">Highlight</h2>
    <figure class="bg-surface dark:bg-surface-dark p-5 rounded-lg shadow-md dark:shadow-light/10">
      <h3 class="font-body text-xl mb-3 no-underline decoration-0">
        {entry.data.title}
      </h3>
      <dl class="font-body text-base leading-relaxed">
        <dt class="badge">Situation</dt>
        <dd class="mt-2 mb-4">{entry.data.situation}</dd>

        <dt class="badge">Task</dt>
        <dd class="mt-2 mb-4">{entry.data.task}</dd>

        <dt class="badge">Action</dt>
        <dd class="mt-2 mb-4">{entry.data.action}</dd>

        <dt class="badge">Result</dt>
        <dd class="mt-2">{entry.data.result}</dd>
      </dl>
      {entry.data.tags.length > 0 && (
        <div class="flex flex-wrap mt-4">
          {entry.data.tags.map((tag: string) => (
            <span class="badge">{tag}</span>
          ))}
        </div>
      )}
    </figure>
  </section>
)}
