---
import BaseLayout from './Layout.astro';
import type { CollectionEntry } from 'astro:content';
import Hero from "@components/Hero.astro";
import Prose from "@components/Prose.astro";
import RelatedContent from "@components/RelatedContent.astro";
interface Props {
    frontmatter: CollectionEntry<'blog'>['data'];
}

const { frontmatter } = Astro.props;
const { title, tags, author } = frontmatter;

// Author ids are slugs; show them as names rather than raw kebab-case.
const authorName = String(author.id)
    .split('-')
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(' ');
---
<BaseLayout pageTitle={title}>
    <Hero alt="RaccoonLaptopGif" src="/laptop.webp"/>
    <article>
        <h1 class="page-title">{title}</h1>
        <p class="font-body text-sm opacity-80 mt-2">{authorName}</p>
        {tags.length > 0 && (
            <ul class="flex flex-wrap gap-1 list-none p-0 mt-3">
                {/* Previously a braced arrow function with no return, so the
                    tags silently rendered nothing at all. */}
                {tags.map((tag: string) => (
                    <li><span class="badge">{tag}</span></li>
                ))}
            </ul>
        )}
        <div class="mt-6">
            <Prose>
                <slot />
            </Prose>
        </div>
        <RelatedContent related={frontmatter.related} />
    </article>
</BaseLayout>
