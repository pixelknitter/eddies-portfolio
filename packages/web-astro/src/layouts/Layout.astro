---
import { ClientRouter } from 'astro:transitions';
import { fade } from 'astro:transitions';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { resolveSections } from '@util/flags/sections.mjs';
import '../styles/global.css';
import '../styles/motion.css';

interface Props {
  pageTitle: string;
  /**
   * Page-specific meta description. Defaults to the site-wide blurb, which is
   * what every page used before the resume needed its own — a resume page
   * described as "a portfolio ... ranging from mobile" is a wasted snippet in
   * both search results and generative-engine summaries.
   */
  description?: string;
}

/**
 * The site-wide fallback. Kept verbatim so pages that pass no description
 * render exactly what they rendered before this prop existed.
 */
const SITE_DESCRIPTION =
  'A portfolio of Eddie Freeman containing projects ranging from mobile (react native), nextjs, astro, and LLMs';

const { pageTitle, description = SITE_DESCRIPTION } = Astro.props;

/*
 * Whether analytics loads on this page at all, and how widely.
 *
 * Resolved here — server-side, at render time — so the decision is made before
 * a byte ships. A client-side check would have downloaded the SDK and then
 * decided not to use it, which is the expensive way to say no.
 *
 * `analytics` is derived from the key existing; `analyticsSiteWide` is the
 * scope switch, flag-controlled so it can move without a deploy. Feedback-only
 * is the default, in which case nothing loads here and the A.I.R. island
 * imports the SDK itself when someone actually asks a question.
 */
const sections = await resolveSections(import.meta.env);
const loadAnalytics = sections.analytics && sections.analyticsSiteWide;
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;

// Identifies which build is live. The deploy pipeline polls this to confirm
// the new Worker version is actually serving before it smoke-tests, and it
// answers "what is deployed right now?" without reading CI logs.
const buildSha = import.meta.env.PUBLIC_BUILD_SHA ?? 'dev';
---

<!doctype html>
<html transition:animate="none" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Josefin+Sans&family=Pacifico&display=swap"
      as="style"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Josefin+Sans&family=Pacifico&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="build-sha" content={buildSha} />
    <title>{pageTitle}</title>
    {
      /*
      Page-specific head content: extra font families, JSON-LD, rel=alternate.
      A slot rather than a growing list of props — the resume needs a structured
      -data block and two more font families, and neither belongs on every route.
      Content placed here is inert for pages that pass nothing.
    */
    }
    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main transition:animate={fade({ duration: '0.2s' })}>
      <slot />
      <Footer />
    </main>
    <script>
      function applyTheme() {
        const theme = localStorage.getItem('theme');
        const prefersDark = window.matchMedia(
          '(prefers-color-scheme: dark)',
        ).matches;
        if (theme === 'dark' || (!theme && prefersDark)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      }

      // Apply theme on initial load
      applyTheme();

      // Apply theme after view transitions
      document.addEventListener('astro:after-swap', () => {
        applyTheme();
      });

      // Listen for storage events to sync theme across tabs
      window.addEventListener('storage', (event) => {
        if (event.key === 'theme') {
          applyTheme();
        }
      });
    </script>
    {
      loadAnalytics && (
        <script define:vars={{ posthogKey }}>
          {/*
            Bound to astro:page-load rather than run at module scope.

            A view transition swaps the document without a page load, so
            module-scope code runs exactly once and every navigation after the
            first would go uncounted. This event fires on both, which is why the
            SDK's own capture_pageview is turned off in the adapter.

            loadClient is single-flight, so the repeat firings cost nothing.
          */}
          document.addEventListener('astro:page-load', async () => {
            const { loadClient, getClient } = await import(
              '../util/telemetry/client.mjs'
            );
            await loadClient({ token: posthogKey });
            getClient().pageview(window.location.pathname);
          });
        </script>
      )
    }
  </body>
</html>
