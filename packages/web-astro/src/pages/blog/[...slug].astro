---
import { getEntry, render } from 'astro:content';
import MarkdownBlogLayout from '@layouts/MarkdownBlogLayout.astro';
import { isPublished } from '@util/posts.mjs';
import { resolveSections } from '@util/flags/sections.mjs';

// Rendered per request rather than prerendered. A scheduled post must 404
// until its publishDate passes, and a prerendered page would already exist on
// disk and be reachable by direct URL. Serving this route from the Worker is
// what lets scheduling work with no rebuild, cron, or deploy.
const { slug } = Astro.params;

const entry = slug ? await getEntry('blog', slug) : undefined;

// Drafts and not-yet-due posts are indistinguishable from missing in
// production; locally everything is viewable so scheduled work can be checked.
const sections = await resolveSections(import.meta.env);
const visible = entry && (sections.unpublished || isPublished(entry.data));

if (!sections.blog || !entry || !visible) {
    return new Response(null, { status: 404, statusText: 'Not found' });
}

const { Content } = await render(entry);
---

<MarkdownBlogLayout frontmatter={entry.data}>
    <Content />
</MarkdownBlogLayout>
