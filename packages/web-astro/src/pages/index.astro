---
import Layout from '@layouts/Layout.astro';
import Prose from '@components/Prose.astro'

import {Content as About, frontmatter as aboutMatter} from '../static/about.md';
import Hero from '@components/Hero.astro';
import MyBlocksSection from "@components/MyBlocksSection.astro";
import { buildingBlocks } from "@util/constants";
import AnimateOnScroll from "@components/AnimateOnScroll.astro";
import StarSpotlight from "@components/StarSpotlight.astro";
import LatestWork from "@components/LatestWork.astro";

const { title: pageTitle, badges, subject } = aboutMatter;
---
<Layout pageTitle={pageTitle}>
    <Hero alt="RaccoonSpaceGif" src="/space.webp"/>
    <h1>{subject}</h1>
    <div class="flex flex-wrap mb-6">
        {/*
          `.badge` rather than the same utilities written out again. These
          personas were a hand-rolled copy of that class, differing only in
          font size (0.85rem against text-sm's 0.875rem) — close enough to be
          unintentional. A copy does not follow the original: the pill gained a
          light-mode fill and this would have kept the dark one, on the page
          that shows the most of them.
        */}
        {badges.map((badge: string) => <span class="badge place-content-center">{badge}</span> )}
    </div>
    <Prose>
        <About />
    </Prose>
    <AnimateOnScroll>
        <StarSpotlight />
    </AnimateOnScroll>
    <AnimateOnScroll>
        <LatestWork />
    </AnimateOnScroll>
    <h2 class="mt-6">My Building Blocks</h2>
    <p class="font-body text-lg mb-6">As a product engineer, how I build is ever-changing, but below are a good number of the blocks I've used in my engineering.</p>
    {Object.entries(buildingBlocks).map(([category, tech]) => (
        <AnimateOnScroll>
            <MyBlocksSection title={category} tech={tech} />
        </AnimateOnScroll>
    ))}
</Layout>

