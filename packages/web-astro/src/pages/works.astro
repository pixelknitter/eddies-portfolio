---
import { getCollection } from "astro:content";
import Layout from '@layouts/Layout.astro';
import Card from '@components/Card.astro';
import Hero from "@components/Hero.astro";
import { showProjects } from "@util/visibility.mjs";

// Gate the route, not just the nav link — an unlisted page is still a public
// page if it responds. Production was serving the placeholder fixtures to
// anyone who had the URL.
if (!showProjects(import.meta.env)) {
    return new Response(null, { status: 404, statusText: 'Not found' });
}

const allProjects = await getCollection("projects");
const pageTitle = "Works";
---
<Layout pageTitle={pageTitle}>
    <Hero alt="RaccoonLaptopGif" src="/laptop.webp"/>
    <h1 class="page-title">Projects</h1>
    <ul role="list" class="card-grid">
        {allProjects.map((card) => <Card
            url={`/projects/${card.id}/`}
            image={card.data.image.url}
            title={card.data.title}
            body={card.data.description}
            alt="ProjectImage"
        />)}
    </ul>
</Layout>

