---
import Layout from '@layouts/Layout.astro';
import Card from '@components/Card.astro';
import { getCollection } from "astro:content";
import { publishedPosts } from "@util/posts.mjs";
import { resolveSections } from "@util/flags/sections.mjs";
import Hero from "@components/Hero.astro";

const sections = await resolveSections(import.meta.env);

// Same reasoning as works.astro — the flag has to gate the page itself.
if (!sections.blog) {
    return new Response(null, { status: 404, statusText: 'Not found' });
}

const pageTitle = "Posts";
// Production shows only published posts. Dev and the dev/staging deploys
// reveal drafts and scheduled work so those tiers aren't empty to review.
const allEntries = await getCollection('blog');
const blogEntries = sections.unpublished
    ? allEntries
    : publishedPosts(allEntries);
---
<Layout pageTitle={pageTitle}>
    <Hero alt="RaccoonLaptopGif" src="/blog.webp"/>
    <h1 class="page-title">Blog</h1>
    <!-- TODO: connect this to Medium/Substack -->
    <ul role="list" class="card-grid">
        {blogEntries.map((card) => <Card
            url={`/blog/${card.id}/`}
            image={card.data.heroImage.url}
            title={card.data.title}
            body={card.data.hook ?? card.data.blurb}
            alt={card.data.heroImage.alt}
        />)}
    </ul>
