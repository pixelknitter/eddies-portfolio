---
import Layout from '@layouts/Layout.astro';
import Card from '@components/Card.astro';
import { getCollection } from "astro:content";
import { publishedPosts } from "@util/posts.mjs";
import Hero from "@components/Hero.astro";
const pageTitle = "Posts";
// In production a post must be non-draft *and* past its publishDate. Locally
// everything is shown so scheduled work is easy to preview.
const allEntries = await getCollection('blog');
const blogEntries = import.meta.env.PROD
    ? publishedPosts(allEntries)
    : allEntries;
---
<Layout pageTitle={pageTitle}>
    <Hero alt="RaccoonLaptopGif" src="/blog.webp"/>
    <h2>Blog</h2>
    <!-- TODO: connect this to Medium/Substack -->
    <ul role="list" class="card-grid">
        {blogEntries.map((card) => <Card
            url={`/blog/${card.id}/`}
            image={card.data.heroImage.url}
            title={card.data.title}
            body={card.data.blurb}
            alt="ProjectImage"
        />)}
    </ul>
    <!-- <h2>YouTube</h2>
    <ul role="list" class="link-card-grid">
        <Card
            url="https://www.youtube.com/"
