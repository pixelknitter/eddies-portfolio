---
import Layout from '@layouts/Layout.astro';
import RoleCard from '@components/cv/RoleCard.astro';
import GlowBorder from '@components/GlowBorder.astro';
import { SeedQuestions } from '../../react/SeedQuestions';
import { variantCards } from '@util/resume/load';
import { LANES, seedsForLane } from '@util/air/suggested.mjs';
import { resolveSections } from '@util/flags/sections.mjs';
import '../../styles/resume-organic.css';

/**
 * The CV chooser.
 *
 * ## Why this is a page and not a menu
 *
 * The same career reads differently depending on what someone is hiring for,
 * and the visitor knows which they are while we do not. Asking is cheaper than
 * guessing, and cheaper than one CV that hedges.
 *
 * The cards are content, not navigation: every word on them comes from the
 * variant's own sealed profile, which is what lets a new framing arrive as a
 * content drop rather than a code change.
 *
 * The resume that used to live here is now at `/cv/product`. The site had been
 * live about a week when this changed, so there was no accumulated equity to
 * protect, and a pure chooser reads cleaner than a chooser bolted above a full
 * document.
 *
 * The route is guarded, not just the nav link. An unlisted page is still a
 * public page if it responds.
 */
export const prerender = false;

const sections = await resolveSections(import.meta.env);
if (!sections.resume) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

/*
 * No cards means no content, which means the seal key is absent. 404 rather
 * than publish a chooser with nothing to choose between.
 */
const cards = await variantCards();
if (cards.length === 0) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

/*
 * Every lane, not only the lanes with a CV behind them.
 *
 * A seed has to be answerable from the corpus, not from a particular document —
 * so the leadership questions belong here even though the leadership CV is
 * unwritten. Filtering these by `availableVariants` would withhold answers the
 * record can already give.
 */
const seeds = Object.fromEntries(
  LANES.map((lane) => [lane, seedsForLane(lane)]),
);

const pageTitle = 'Eddie Freeman — CV';
const description =
  'Eddie Freeman’s CV, in the framing that fits what you are hiring for.';
---

<Layout {pageTitle} {description}>
  <Fragment slot="head">
    {
      /*
      The two families the organic design needs, matching the variant pages so
      moving between them costs no font swap. Loaded here rather than in
      Layout.astro so no other route pays for them.
    */
    }
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Caprasimo:wght@400&family=Figtree:wght@400;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caprasimo:wght@400&family=Figtree:wght@400;600;700&display=swap"
    />
  </Fragment>

  {/* No <main> here: Layout.astro already renders one, and nesting a second
      is invalid and leaves `locator('main')` matching two elements. */}
  <div class="mx-auto max-w-3xl px-4 py-10">
    {
      /*
      `organic` scopes the resume document's own typography, so the masthead and
      the cards read as the same family as the CV they lead to. It is applied to
      these two bands rather than to `main` on purpose: the seed questions below
      open a dialog that renders inside whatever wrapper its trigger sits in,
      and inheriting the document's display face there overlapped the dialog's
      heading with the label beneath it. Same lesson `[variant].astro` records
      about the A.I.R. trigger.
    */
    }
    <div class="organic">
      <section class="mb-10">
        <h1 class="mb-4 font-header text-3xl leading-tight sm:text-4xl">
          What are you hiring for?
        </h1>
        <p class="font-body text-lg leading-relaxed">
          The work is the same either way. What changes is which parts of it
          matter to you, so pick the version that fits the problem you are
          trying to solve and read that one.
        </p>
      </section>

      <section aria-labelledby="cv-versions" class="mb-12">
        <h2 id="cv-versions" class="sr-only">Versions of this CV</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            cards.map((card) => (
              <RoleCard
                href={card.path}
                headline={card.headline}
                pitch={card.pitch}
              />
            ))
          }
        </div>
      </section>

      {/* Renders nothing; wires the cards' pointer-tracked border. */}
      <GlowBorder />
    </div>

    {
      /*
      Hidden entirely when A.I.R. is off. The two features ship independently,
      and a band of questions that open nothing is worse than no band.

      Deliberately outside the `organic` scope above: that class carries the
      resume document's own typography at a specificity utilities cannot beat,
      and the dialog these open renders inside whatever wrapper its trigger sits
      in. `[variant].astro` records the same lesson about the A.I.R. trigger.
    */
    }
    {
      sections.air && (
        <section aria-labelledby="cv-seeds" class="mb-12">
          <h2 id="cv-seeds" class="mb-3 font-header text-xl">
            Or start with a question
          </h2>
          <p class="mb-4 font-body leading-relaxed">
            Tell it the problem you are trying to solve. It answers from a fixed
            record of the work, and says so when the record does not cover it.
          </p>
          <SeedQuestions client:visible seeds={seeds} />
        </section>
      )
    }

    {
      /*
      Adapted from the A.I.R. prototype. It belongs at the foot of the page a
      visitor is about to ask questions from: the promise is worth making before
      the first question rather than after the first answer.
    */
    }
    <footer
      class="border-t border-hairline pt-6 font-body text-sm leading-relaxed opacity-75 dark:border-hairline-dark"
    >
      <p>Answers are drawn from a fixed record. Nothing is invented.</p>
    </footer>
  </div>
</Layout>
