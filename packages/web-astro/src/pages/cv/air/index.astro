---
import Layout from "@layouts/Layout.astro"
import { AIResume } from '../../../react/AIResume'
import { resolveSections } from '@util/flags/sections.mjs'

// Gate the route, not just the nav link — an unlisted page is still a public
// page if it responds.
const sections = await resolveSections(import.meta.env);

if (!sections.air) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const pageTitle = "AIR: AI-Powered Resume for Eddie Freeman"
---
<Layout pageTitle={pageTitle}>
  <AIResume client:load />

  {/*
    A.I.R. needs an invitation; the resume does not. Someone who arrives here
    without a code currently hits a dead end, so point them at the version they
    can read right now. Placed after the island rather than before it so the
    page still opens on A.I.R. itself.
  */}
  {
    sections.resume && (
      <p class="mt-8 text-center font-body">
        <a href="/cv/">Read the resume instead &rarr;</a>
      </p>
    )
  }
</Layout>
