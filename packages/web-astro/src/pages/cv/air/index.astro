---
import Layout from "@layouts/Layout.astro"
import { AIResume } from '../../../react/AIResume'
import { resolveSections } from '@util/flags/sections.mjs'

// Gate the route, not just the nav link — an unlisted page is still a public
// page if it responds.
const sections = await resolveSections(import.meta.env);

if (!sections.air) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const pageTitle = "Ask A.I.R. — Eddie Freeman's résumé"
---
<Layout pageTitle={pageTitle}>
  {/*
    The way back to the résumé, above the island rather than below it.
    It used to sit at the bottom as a consolation for anyone who arrived
    without an access code and hit a dead end. Now that the résumé is the
    parent route, this is navigation: A.I.R. is one way to read the CV, and
    the other way should be reachable without scrolling past a gate to find
    it. Rendered only when the résumé is actually live, so it can never point
    at a 404.
  */}
  {
    sections.resume && (
      <p class="mt-4 font-body">
        <a class="nav-link !mx-0" href="/cv/">&larr; Back to the résumé</a>
      </p>
    )
  }

  <AIResume client:load />
</Layout>
