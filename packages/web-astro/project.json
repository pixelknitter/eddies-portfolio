{
  "name": "web-astro",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/web-astro/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": [
        "{projectRoot}/dist"
      ],
      "options": {
        "command": "env -u ANTHROPIC_API_KEY -u AIR_SIGNING_SECRET -u AIR_ACCESS_CODE -u CONTENT_SEAL_KEY -u DISCORD_WEBHOOK_URL astro build",
        "cwd": "packages/web-astro"
      },
      "inputs": [
        "default",
        "^default",
        {
          "env": "PUBLIC_BUILD_SHA"
        },
        {
          "env": "PUBLIC_SHOW_UNPUBLISHED"
        },
        {
          "env": "PUBLIC_SHOW_AIR"
        },
        {
          "env": "PUBLIC_SHOW_BLOG"
        },
        {
          "env": "PUBLIC_SHOW_PROJECTS"
        },
        {
          "env": "PUBLIC_SHOW_HIGHLIGHTS"
        },
        {
          "env": "PUBLIC_SHOW_FIXTURES"
        },
        {
          "env": "PUBLIC_SHOW_RESUME"
        },
        {
          "env": "PUBLIC_RESUME_PRINT"
        }
      ]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro dev",
        "cwd": "packages/web-astro"
      }
    },
    "preview": {
      "dependsOn": [
        "build"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "astro preview",
        "cwd": "packages/web-astro"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "astro check",
        "cwd": "packages/web-astro"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "packages/web-astro/**/*.{js,jsx,ts,tsx,astro}"
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "vitest run",
        "cwd": "packages/web-astro"
      },
      "configurations": {
        "watch": {
          "command": "vitest"
        }
      }
    }
  }
}
