{
  "name": "web-astro",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "packages/web-astro/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/packages/web-astro"],
      "options": {
        "command": "astro build",
        "cwd": "packages/web-astro"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "astro dev",
        "cwd": "packages/web-astro"
      }
    },
    "preview": {
      "dependsOn": ["build"],
      "executor": "nx:run-commands",
      "options": {
        "command": "astro preview",
        "cwd": "packages/web-astro"
      }
    },
    "check": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "astro check",
        "cwd": "packages/web-astro"
      }
    },
    "lint": {
      "executor": "@nx/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": [
          "packages/web-astro/**/*.{js,jsx,ts,tsx,astro}"
        ]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "options": {
        "command": "vitest run",
        "cwd": "packages/web-astro"
      },
      "configurations": {
        "watch": {
          "command": "vitest"
        }
      }
    }
  }
}
