{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Base Worker config. The Astro Cloudflare adapter merges this with the
  // generated values (entry point, static-asset binding, session KV) and
  // writes the result to dist/server/wrangler.json at build time.
  "name": "eddies-portfolio",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  // Required for *.workers.dev URLs and for per-version preview URLs.
  "workers_dev": true,
  "observability": { "enabled": true },
  // Transactional email for A.I.R. access approvals. No API key — the binding
  // authenticates as the Worker. The `from` domain must be onboarded first:
  //   npx wrangler email sending enable eddie.engineering
  "send_email": [{ "name": "EMAIL" }],
  // Production hostname. A hostname can only be bound to one service, so
  // `eddie.engineering` must be REMOVED from the Cloudflare Pages project
  // before the first `wrangler deploy` that carries this config — otherwise
  // the deploy fails with the hostname already in use. See the cutover
  // checklist in docs/DEPLOYMENT.md.
  //
  // Preview deploys never inherit this: scripts/make-preview-wrangler.mjs
  // replaces `routes` wholesale with the preview's own Custom Domain.
  "routes": [
    { "pattern": "eddie.engineering", "custom_domain": true }
  ]
}
