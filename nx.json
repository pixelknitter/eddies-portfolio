{
  "targetDefaults": {
    "test": {
      "inputs": [
        "default",
        "^default"
      ],
      "cache": true
    },
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/eslint.config.mjs"
      ],
      "cache": true
    },
    "build": {
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ]
    },
    "e2e": {
      "cache": true
    },
    "check": {
      "cache": true
    }
  },
  "defaultProject": "web-astro",
  "extends": "nx/presets/npm.json"
}
