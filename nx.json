{
  "targetDefaults": {
    "test": {
      "inputs": [
        "default",
        "^default"
      ],
      "cache": true
    },
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore"
      ],
      "cache": true
    },
    "build": {
      "cache": true,
      "inputs": [
        "default",
        "^default"
      ]
    },
    "e2e": {
      "cache": true
    },
    "check": {
      "cache": true
    }
  },
  "generators": {
    "@nx/react": {
      "application": {
        "babel": true
      }
    },
    "@nx/next": {
      "application": {
        "style": "css",
        "linter": "eslint"
      }
    }
  },
  "defaultProject": "web-astro",
  "extends": "nx/presets/npm.json",
